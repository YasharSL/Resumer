{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classic-sidebar-schema",
  "title": "Classic Sidebar resume data",
  "type": "object",
  "additionalProperties": true,
  "required": ["basics", "experience", "skills"],
  "properties": {
    "template": { "type": "string" },
    "extends": { "type": "string" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputName": { "type": "string", "minLength": 1 }
      }
    },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "label": { "type": "string" }
          }
        },
        "linkedin": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "label": { "type": "string" }
          }
        },
        "website": {
          "type": "object",
          "required": ["url"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "label": { "type": "string" }
          }
        }
      }
    },
    "photo": {
      "description": "Optional profile photo (template-specific).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "alt": { "type": "string" }
          }
        }
      ]
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "company"],
        "properties": {
          "role": { "type": "string" },
          "company": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": ["string", "null"] },
          "location": { "type": "string" },
          "highlights": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["institution"],
        "properties": {
          "institution": { "type": "string" },
          "degree": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": ["string", "null"] },
          "location": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        ]
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        ]
      }
    }
  }
}
