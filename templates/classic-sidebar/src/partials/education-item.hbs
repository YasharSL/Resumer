<article class="edu">
  <header class="edu__head">
    <div class="edu__body">
      <h3 class="edu__school">
        {{institution}}{{#if location}}, {{location}}{{/if}}
      </h3>
      {{#if degree}}
        <p class="edu__degree">{{degree}}</p>
      {{/if}}
    </div>
    <span class="edu__dates">{{yearRange start end}}</span>
  </header>
</article>
