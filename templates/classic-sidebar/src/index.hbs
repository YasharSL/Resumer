<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{basics.name}} — Resume</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet" />
  <style>{{{styles}}}</style>
</head>
<body>
  <article class="resume">
    <header class="header">
      <div class="header__identity">
        {{#if photoSrc}}
          <img class="header__photo" src="{{photoSrc}}" alt="{{#if photo.alt}}{{photo.alt}}{{else}}{{basics.name}}{{/if}}" />
        {{/if}}
        <div class="header__text">
          <h1 class="name">{{basics.name}}</h1>
          {{#if basics.title}}
            <p class="role">{{basics.title}}</p>
          {{/if}}
          <div class="contacts">
            {{#if basics.email}}
              <a class="contact" href="mailto:{{basics.email}}">{{basics.email}}</a>
            {{/if}}
            {{#if profiles.github}}
              <a class="contact contact--icon" href="{{profiles.github.url}}">
                {{> icon-github}}
                <span>{{#if profiles.github.label}}{{profiles.github.label}}{{else}}{{displayUrl profiles.github.url}}{{/if}}</span>
              </a>
            {{/if}}
            {{#if profiles.linkedin}}
              <a class="contact contact--icon" href="{{profiles.linkedin.url}}">
                {{> icon-linkedin}}
                <span>{{#if profiles.linkedin.label}}{{profiles.linkedin.label}}{{else}}{{displayUrl profiles.linkedin.url}}{{/if}}</span>
              </a>
            {{/if}}
            {{#if profiles.website}}
              <a class="contact" href="{{profiles.website.url}}">
                {{#if profiles.website.label}}{{profiles.website.label}}{{else}}{{displayUrl profiles.website.url}}{{/if}}
              </a>
            {{/if}}
            {{#if basics.phone}}
              <span class="contact">{{basics.phone}}</span>
            {{/if}}
            {{#if basics.location}}
              <span class="contact">{{basics.location}}</span>
            {{/if}}
          </div>
        </div>
      </div>
    </header>

    {{#if basics.summary}}
      <section class="profile">
        <h2 class="section-title">Profile</h2>
        <p class="profile__text">{{basics.summary}}</p>
      </section>
    {{/if}}

    <div class="body">
      <div class="main">
        {{#if experience.length}}
          <section class="section">
            <h2 class="section-title">Employment</h2>
            {{#each experience}}
              {{> experience-item}}
            {{/each}}
          </section>
        {{/if}}

        {{#if education.length}}
          <section class="section">
            <h2 class="section-title">Education</h2>
            {{#each education}}
              {{> education-item}}
            {{/each}}
          </section>
        {{/if}}

        {{#if projects.length}}
          <section class="section">
            <h2 class="section-title">Projects / Independent Learning</h2>
            <ul class="bullets">
              {{#each projects}}
                {{> project-item}}
              {{/each}}
            </ul>
          </section>
        {{/if}}
      </div>

      <aside class="side">
        {{#if skills.length}}
          <section class="section section--skills">
            <h2 class="section-title">Skills</h2>
            <ul class="skills">
              {{#each skills}}
                {{> skill-item}}
              {{/each}}
            </ul>
          </section>
        {{/if}}
      </aside>
    </div>
  </article>
</body>
</html>
